1# Copia este archivo a ".env" y completa los valores.

# Puerto del backend en local (por defecto 4000)
PORT=4000

# --- Base de datos (libSQL / Turso) ---
# En LOCAL puedes dejar esto vacío: se usa un archivo SQLite local (file:polla.db).
# En PRODUCCIÓN (Vercel) define la URL y el token que te da Turso:
#   TURSO_DATABASE_URL=libsql://tu-base-xxxx.turso.io
#   TURSO_AUTH_TOKEN=eyJ...
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Login con Google ---
# Client ID de OAuth (Google Cloud Console > Credenciales > ID de cliente OAuth, "Aplicación web").
# Si lo dejas vacío, se activa el LOGIN DE DESARROLLO (entrar solo con email, sin Google).
GOOGLE_CLIENT_ID=

# Emails que siempre serán administradores (separados por coma).
# Además, el PRIMER usuario que entra queda como admin automáticamente.
ADMIN_EMAILS=

# --- Resultados EN VIVO (provisionales) ---
# Un cron externo debe pegar cada ~3 min a:  GET /api/cron/live?key=CRON_SECRET
# CRON_SECRET: secreto compartido con el cron para autorizar la llamada.
CRON_SECRET=

# API deportiva para marcadores en vivo (API-Football / api-sports.io).
# Sin LIVE_API_KEY, el endpoint /api/cron/live no consulta nada (queda inactivo).
LIVE_API_KEY=
# Opcionales (traen valores por defecto razonables para el Mundial 2026):
#   LIVE_API_HOST=v3.football.api-sports.io
#   LIVE_LEAGUE_ID=1
#   LIVE_SEASON=2026
