# Copia este archivo a ".env" y completa los valores.

# Puerto del backend (por defecto 4000)
PORT=4000

# --- Login con Google ---
# Client ID de OAuth (Google Cloud Console > Credenciales > ID de cliente OAuth, tipo "Aplicacion web").
# Si lo dejas vacio, se activa el LOGIN DE DESARROLLO (entrar solo con email, sin Google).
GOOGLE_CLIENT_ID=

# Emails que siempre seran administradores (separados por coma).
# Ademas, el PRIMER usuario que entra queda como admin automaticamente.
ADMIN_EMAILS=nruiz@copec.cl

# Ruta del archivo de base de datos SQLite (opcional)
# DB_PATH=./polla.db
