# Copia este archivo a ".env" y completa los valores.

# Puerto del backend en local (por defecto 4000)
PORT=4000

# --- Base de datos (libSQL / Turso) ---
# En LOCAL puedes dejar esto vacío: se usa un archivo SQLite local (file:polla.db).
# En PRODUCCIÓN (Vercel) define la URL y el token que te da Turso:
#   TURSO_DATABASE_URL=libsql://tu-base-xxxx.turso.io
#   TURSO_AUTH_TOKEN=eyJ...
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Login con Google ---
# Client ID de OAuth (Google Cloud Console > Credenciales > ID de cliente OAuth, "Aplicación web").
# Si lo dejas vacío, se activa el LOGIN DE DESARROLLO (entrar solo con email, sin Google).
GOOGLE_CLIENT_ID=

# Emails que siempre serán administradores (separados por coma).
# Además, el PRIMER usuario que entra queda como admin automáticamente.
